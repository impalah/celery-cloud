CELERY_BACKEND_REGION=<AWS_REGION>
CELERY_BACKEND_TABLE=<DYNAMO_TABLE>
LOG_LEVEL=<DEBUG, ERROR, INFO, WARNING, CRITICAL>
LOG_FORMAT="{time:YYYY-MM-DD HH:mm:ss} | {level: <8} | trace_id={extra[trace_id]} | {name}:{function}: {line} - {message}"
TASKS="{\"celery_cloud.celery.task.sumar\": \"lambda://arn:aws:lambda:eu-central-1:123456789012:function:prompt-test\", \"celery_cloud.celery.task.restar\": \"task://celery_cloud.domain.restar/restar\", \"celery_cloud.celery.task.prompt\": \"task://celery_cloud.domain.prompt/prompt\", \"celery_cloud.celery.task.lsumar\": \"lambda://arn:aws:lambda:eu-central-1:123456789012:function:granite-api\"}"

# Seconds a stored result is kept (written as the `ttl` attribute; enable TTL on the table
# for the attribute `ttl` so DynamoDB deletes expired items). 0 = never
RESULT_TTL_SECONDS=86400

# Seconds kept free before the Lambda timeout (tasks are stopped this long before AWS kills the function)
TIMEOUT_MARGIN_SECONDS=10
# Store name/args/kwargs/worker/retries/queue in the result (Celery result_extended). Args may be sensitive
RESULT_EXTENDED=false

# Records of a batch processed at the same time (threads). 1 = one after the other
BATCH_CONCURRENCY=1
# json, msgpack or yaml (must match the client's result_serializer)
RESULT_SERIALIZER=json
# Modules imported once at start-up (to connect signal receivers), comma separated
INIT_MODULES=
# CloudWatch metrics (Embedded Metric Format) in the log
METRICS_ENABLED=false
METRICS_NAMESPACE=CeleryCloud
